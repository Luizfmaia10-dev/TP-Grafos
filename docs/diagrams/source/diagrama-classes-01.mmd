classDiagram
    class Station {
        +str station_id
        +str name
        +float latitude
        +float longitude
        +__hash__() int
        +__eq__(other) bool
    }
    class TemporaryVertex {
        +str marker_type
    }
    class VehicleType {
        <<enumeration>>
        BUS
        SUBWAY
        WALK
    }
    class Connection {
        +str route_id
        +str route_short_name
        +Station destination
        +VehicleType vehicle_type
        +float travel_time
        +float distance
        +float departure_time
    }
    class TransportGraph {
        -dict _adjacency_list
        +add_station(station) None
        +add_connection(origin, connection) None
        +get_neighbors(station) list~Connection~
        +iter_stations() Iterator~Station~
        +remove_temporary_vertex(vertex) None
    }
    class DataLoader {
        +Path data_directory
        +LoadReport report
        +build_graph() TransportGraph
    }
    class Itinerary {
        +Station origin
        +Station destination
        +str departure_time
        +str arrival_time
        +int total_seconds
        +int waiting_seconds
        +int travel_seconds
        +float distance_km
        +tuple steps
        +tuple instructions
        +__init__(origin, departure_time, path)
        +to_dict() dict
        +to_json() str
    }
    class ItineraryStep {
        +Station origin
        +Station destination
        +str route_id
        +str route_short_name
        +VehicleType vehicle_type
        +str departure_time
        +str arrival_time
        +int waiting_seconds
        +int travel_seconds
        +float distance_km
    }
    class TimeUtils {
        +time_to_minutes(time_str)$ float
        +minutes_to_time(minutes)$ str
    }
    class RouteSimulator {
        +TransportGraph graph
        +float max_speed
        +int last_expanded_count
        -dict _temporary_connections
        +calculate_route(...) list | None
        +max_speed_of(graph)$ float
        +heuristic(current, target) float
        +find_snap_candidates(latitude, longitude, max_distance_km) list~SnapCandidate~
        +snap_to_network(latitude, longitude, marker_type, max_distance_km, station_id, label) contextmanager
    }
    class SnapCandidate {
        +Station station
        +float distance_km
    }
    class AddressPoint {
        <<API model>>
        +str label
        +float latitude
        +float longitude
        +int max_walk_meters
        +str station_id
    }
    class RouteSearchRequest {
        <<API model>>
        +str mode
        +str origin_id
        +str destination_id
        +AddressPoint origin
        +AddressPoint destination
        +str departure_time
    }
    class GraphAnalyzer {
        -TransportGraph _graph
        +find_articulation_points() set~Station~
        +find_strongly_connected_components() list
        +criticality_scores() dict
        +get_critical_stations(top_n) list~Station~
    }
    Station <|-- TemporaryVertex
    Connection --> Station : destino
    Connection --> VehicleType : modal
    TransportGraph o-- Station : vértices
    TransportGraph o-- Connection : conexões ordenadas
    DataLoader ..> TransportGraph : constrói
    DataLoader ..> TimeUtils : converte horários
    RouteSimulator --> TransportGraph : consulta
    RouteSimulator ..> TemporaryVertex : cria por consulta
    RouteSimulator ..> SnapCandidate : ordena candidatas
    RouteSearchRequest o-- AddressPoint : origem e destino
    RouteSearchRequest ..> RouteSimulator : valida e aciona
    GraphAnalyzer --> TransportGraph : analisa
    Itinerary o-- ItineraryStep : passos
    Itinerary ..> TimeUtils : formata horários
