{
  "name": "rotasgraph-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Static HTML and Tailwind interface for RotasGraph.",
  "scripts": {
    "build": "node scripts/copy-fonts.mjs && npm run build:css",
    "build:css": "tailwindcss -i ./styles/app.css -o ./assets/app.css --minify",
    "watch:css": "tailwindcss -i ./styles/app.css -o ./assets/app.css --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  }
}
